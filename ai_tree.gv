digraph AI {
  rankdir=TB;
  graph [fontname="DejaVu Sans", fontsize=15, nodesep=0.35, ranksep=0.55, pad=0.3, bgcolor="white", label="LLM tree — ai_nav.xml", labelloc=t, fontcolor="#5D1715"];
  node [shape=box, style="rounded,filled", fillcolor="#F9E9E8", color="#5D1715", fontcolor="#1A1A1A", fontname="DejaVu Sans", fontsize=12, penwidth=1.2, margin="0.14,0.07"];
  edge [color="#666666", arrowsize=0.7, penwidth=1.0];
  RN [label=<<B>RecoveryNode</B><BR/><I>retry up to 6×</I>>];
  PS [label=<<B>PipelineSequence</B><BR/><I>replan while driving</I>>];
  RC [label=<<B>RateController</B><BR/><I>1 Hz</I>>];
  CPP [label="ComputePathToPose", fillcolor="white"];
  RF0 [label=<<B>ReactiveFallback</B><BR/><I>head-on avoidance has priority</I>>];
  S0 [label=<<B>Sequence</B><BR/><I>head-on: diverge</I>>];
  RA [label="robot_avoid?", shape=oval, style=filled, fillcolor="#F5EFD9"];
  ARCA [label="Arc (away)", fillcolor="white"];
  RF1 [label=<<B>ReactiveFallback</B><BR/><I>AI or reactive</I>>];
  SAI [label=<<B>Sequence</B><BR/><I>AiPath</I>>];
  CLA [label="CheckLlmAction", shape=oval, style=filled, fillcolor="#F5EFD9"];
  MENU [label=<<B>Fallback: AI action</B><BR/><I>proceed · slow · yield<BR/>arc left/right · stop · back</I>>];
  SNET [label=<<B>ReactiveFallback</B><BR/><I>reactive safety net<BR/>(same as social tree)</I>>];
  REC [label=<<B>Recovery</B><BR/><I>round-robin</I><BR/><I>clear costmaps → wait 2 s → back up (rear-gated)</I>>, style="rounded,dashed,filled"];
  RN -> PS;
  RN -> REC [style=dashed, label="on failure"];
  PS -> RC;
  RC -> CPP;
  PS -> RF0;
  RF0 -> S0;
  S0 -> RA;
  S0 -> ARCA;
  RF0 -> RF1;
  RF1 -> SAI;
  SAI -> CLA;
  SAI -> MENU;
  RF1 -> SNET;
}
