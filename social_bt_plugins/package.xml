<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>social_bt_plugins</name>
  <version>0.0.0</version>
  <description>Custom C++ BehaviorTree.CPP plugins for socially-aware navigation (IsHumanClose, SetSpeedLimit, AdaptiveYield).</description>
  <maintainer email="ecem@todo.todo">ecem</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>behaviortree_cpp_v3</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
