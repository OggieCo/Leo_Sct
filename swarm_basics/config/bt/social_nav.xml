<!--
  social_nav.xml - Socially-aware navigation Behavior Tree.

  STRUCTURE (2026-08-06):
    - PipelineSequence (Nav2 standard) for correct 1 Hz replanning.  A root
      SequenceStar was tried but it floods ComputePathToPose (RateController
      gating resets every re-tick) -> planner timeouts -> recovery chaos.
    - IsHumanClose lives INSIDE the ReactiveFallback first branch:
      ReactiveFallback re-evaluates its first child EVERY tick, so IsHumanClose
      is ticked continuously WITHOUT disturbing the replan rate.
    - TimeOut(4 s) on the yield: if the human never moves, give up after 4 s
      and continue toward the goal.

  SOCIAL LAYER:
    * YIELD   - {human_close} true -> stop & wait (Wait 1 s, looped).
    * RESUME  - human gone -> FollowPath immediately.
    * TIMEOUT - human still there after 4 s -> continue toward the goal.

  ROBOT-ROBOT LAYER (2026-08-17):
    * IsRobotClose mirrors IsHumanClose but uses the proximity layer
      (/ns/robot_close, /ns/robot_angle) and a wider 30 deg cone.
    * NESTED fallbacks: each ReactiveFallback keeps at most TWO children
      (one async yield + one async FollowPath).  A single fallback with
      THREE async children stops re-ticking the yield branches while
      FollowPath is active (observed in test run_2026-08-17_15-17-58).
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <!-- Replan global path periodically at 1 Hz -->
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <!-- SOCIAL FOLLOW: PURE REACTIVE baseline.  The LLM-driven tree now
             lives in ai_nav.xml — switch with `bt:=ai` on nav2_slam_all. -->
        <RecoveryNode number_of_retries="1" name="SocialFollow">
            <!-- REACTIVE PATH: pure BT social rules (no LLM).  Head-on
                 avoidance uses the ArcOrFollow arc below, gated by
                 {just_yielded} (set by IsRobotClose on a head-on). -->
            <ReactiveFallback name="HumanAwareFollow">
            <!-- YIELD BRANCH (human): ticked EVERY tick.  IsHumanClose
                 refreshes {human_close}; TimeOut gives up after 4 s. -->
            <Timeout msec="4000" name="YieldMax4s">
              <KeepRunningUntilFailure name="YieldToHuman">
                <Sequence name="YieldCheck">
                  <IsHumanClose/>
                  <BlackboardCheckBool value_A="{human_close}" value_B="true" return_on_mismatch="FAILURE">
                    <Wait wait_duration="1.0"/>
                  </BlackboardCheckBool>
                </Sequence>
              </KeepRunningUntilFailure>
            </Timeout>
            <!-- ROBOT-AWARE SUB-TREE: nested fallback so each ReactiveFallback
                 has at most two async children (one yield + FollowPath) -->
            <ReactiveFallback name="RobotAwareFollow">
              <Timeout msec="10000" name="RobotYieldMax">
                <KeepRunningUntilFailure name="YieldToRobot">
                  <Sequence name="RobotYieldCheck">
                    <IsRobotClose/>
                    <BlackboardCheckBool value_A="{robot_close}" value_B="true" return_on_mismatch="FAILURE">
                      <Wait wait_duration="1.0"/>
                    </BlackboardCheckBool>
                  </Sequence>
                </KeepRunningUntilFailure>
              </Timeout>
              <!-- ARC MANEUVER after a 10 s yield: smooth constant-curvature arc
                   (~1 m, 60 deg, turn while driving).  Both rovers arc
                   LEFT; they face opposite ways so they DIVERGE.  No
                   in-place spin -> works with adhesive wheels. -->
              <ReactiveFallback name="ArcOrFollow">
                <Sequence name="ArcThenGo">
                  <BlackboardCheckBool value_A="{just_yielded}" value_B="true" return_on_mismatch="FAILURE">
                    <Sequence name="ArcOnce">
                      <Arc adaptive="true" speed="0.3" time_allowance="6" direction="away"/>
                    </Sequence>
                  </BlackboardCheckBool>
                  <FollowPath path="{path}" controller_id="FollowPath"/>
                </Sequence>
                <FollowPath path="{path}" controller_id="FollowPath"/>
              </ReactiveFallback>
            </ReactiveFallback>
          </ReactiveFallback>

          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>

      <!-- Recovery fallback when stuck / planning fails -->
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <!-- NO in-place Spin: real rovers have adhesive-taped wheels and
               cannot rotate in place.  Recovery = clear + wait + backup only. -->
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.6" backup_speed="0.5"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
