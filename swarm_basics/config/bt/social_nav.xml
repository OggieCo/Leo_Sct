<!--
  social_nav.xml - Socially-aware navigation Behavior Tree.

  STRUCTURE (2026-08-06):
    - PipelineSequence (Nav2 standard) for correct 1 Hz replanning.  A root
      SequenceStar was tried but it floods ComputePathToPose (RateController
      gating resets every re-tick) -> planner timeouts -> recovery chaos.
    - IsHumanClose lives INSIDE the ReactiveFallback first branch:
      ReactiveFallback re-evaluates its first child EVERY tick, so IsHumanClose
      is ticked continuously WITHOUT disturbing the replan rate.
    - TimeOut(4 s) on the yield: if the human never moves, give up after 4 s
      and continue toward the goal.

  SOCIAL LAYER:
    * YIELD   - {human_close} true -> stop & wait (Wait 1 s, looped).
    * RESUME  - human gone -> FollowPath immediately.
    * TIMEOUT - human still there after 4 s -> continue toward the goal.

  ROBOT-ROBOT LAYER (2026-08-17):
    * IsRobotClose mirrors IsHumanClose but uses the proximity layer
      (/ns/robot_close, /ns/robot_angle) and a wider 30 deg cone.
    * NESTED fallbacks: each ReactiveFallback keeps at most TWO children
      (one async yield + one async FollowPath).  A single fallback with
      THREE async children stops re-ticking the yield branches while
      FollowPath is active (observed in test run_2026-08-17_15-17-58).
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <!-- Replan global path periodically at 1 Hz -->
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <!-- SOCIAL FOLLOW: LLM-planned primary, reactive rules as fallback -->
        <RecoveryNode number_of_retries="1" name="SocialFollow">
          <ReactiveFallback name="LlmOrReactive">
            <!-- LLM-GUIDED PATH (primary): active when llm_planner publishes
                 an action.  CheckLlmAction refreshes {llm_action}/{llm_reason};
                 an empty action (no planner) fails this path so the reactive
                 fallback below takes over. -->
            <Sequence name="LlmPath">
              <CheckLlmAction/>
              <!-- Execute the LLM's action ONLY when it is non-empty.  Empty
                   action (no LLM / no decision) makes EVERY branch below
                   FAIL, so LlmPath FAILS and the reactive fallback
                   (HumanAwareFollow) takes over.  NOTE: BlackboardCheckString
                   is a DECORATOR (ticks child when value_A == value_B); the
                   old wrapper value_B="" had the logic INVERTED — it always
                   ran LlmActionExec's FollowPath and the reactive rules
                   never executed (caused the 17-43 / 17-54 collisions). -->
              <ReactiveFallback name="LlmActionExec">
                <KeepRunningUntilFailure name="LlmYield">
                  <BlackboardCheckString value_A="{llm_action}" value_B="yield" return_on_mismatch="FAILURE">
                    <Wait wait_duration="1.0"/>
                  </BlackboardCheckString>
                </KeepRunningUntilFailure>
                <Sequence name="LlmArc">
                  <BlackboardCheckString value_A="{llm_action}" value_B="arc" return_on_mismatch="FAILURE">
                    <Arc arc_angle="1.05" radius="0.95" speed="0.3" time_allowance="6" direction="away"/>
                  </BlackboardCheckString>
                </Sequence>
                <Sequence name="LlmStop">
                  <BlackboardCheckString value_A="{llm_action}" value_B="stop" return_on_mismatch="FAILURE">
                    <Wait wait_duration="5"/>
                  </BlackboardCheckString>
                </Sequence>
                <Sequence name="LlmProceed">
                  <BlackboardCheckString value_A="{llm_action}" value_B="proceed" return_on_mismatch="FAILURE">
                    <FollowPath path="{path}" controller_id="FollowPath"/>
                  </BlackboardCheckString>
                </Sequence>
              </ReactiveFallback>
            </Sequence>
            <!-- REACTIVE PATH (safety fallback): used when no LLM action -->
            <ReactiveFallback name="HumanAwareFollow">
            <!-- YIELD BRANCH (human): ticked EVERY tick.  IsHumanClose
                 refreshes {human_close}; TimeOut gives up after 4 s. -->
            <Timeout msec="4000" name="YieldMax4s">
              <KeepRunningUntilFailure name="YieldToHuman">
                <Sequence name="YieldCheck">
                  <IsHumanClose/>
                  <BlackboardCheckBool value_A="{human_close}" value_B="true" return_on_mismatch="FAILURE">
                    <Wait wait_duration="1.0"/>
                  </BlackboardCheckBool>
                </Sequence>
              </KeepRunningUntilFailure>
            </Timeout>
            <!-- ROBOT-AWARE SUB-TREE: nested fallback so each ReactiveFallback
                 has at most two async children (one yield + FollowPath) -->
            <ReactiveFallback name="RobotAwareFollow">
              <Timeout msec="10000" name="RobotYieldMax">
                <KeepRunningUntilFailure name="YieldToRobot">
                  <Sequence name="RobotYieldCheck">
                    <IsRobotClose/>
                    <BlackboardCheckBool value_A="{robot_close}" value_B="true" return_on_mismatch="FAILURE">
                      <Wait wait_duration="1.0"/>
                    </BlackboardCheckBool>
                  </Sequence>
                </KeepRunningUntilFailure>
              </Timeout>
              <!-- ARC MANEUVER after a 10 s yield: smooth constant-curvature arc
                   (~1 m, 60 deg, turn while driving).  Both rovers arc
                   LEFT; they face opposite ways so they DIVERGE.  No
                   in-place spin -> works with adhesive wheels. -->
              <ReactiveFallback name="ArcOrFollow">
                <Sequence name="ArcThenGo">
                  <BlackboardCheckBool value_A="{just_yielded}" value_B="true" return_on_mismatch="FAILURE">
                    <Sequence name="ArcOnce">
                      <Arc arc_angle="1.05" radius="0.95" speed="0.3" time_allowance="6" direction="away"/>
                    </Sequence>
                  </BlackboardCheckBool>
                  <FollowPath path="{path}" controller_id="FollowPath"/>
                </Sequence>
                <FollowPath path="{path}" controller_id="FollowPath"/>
              </ReactiveFallback>
            </ReactiveFallback>
          </ReactiveFallback>
          </ReactiveFallback>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>

      <!-- Recovery fallback when stuck / planning fails -->
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <!-- NO in-place Spin: real rovers have adhesive-taped wheels and
               cannot rotate in place.  Recovery = clear + wait + backup only. -->
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
