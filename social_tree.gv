digraph BT {
  rankdir=TB;
  graph [fontname="DejaVu Sans", fontsize=15, nodesep=0.35, ranksep=0.55, pad=0.3, bgcolor="white", label="Reactive social tree — social_nav.xml", labelloc=t, fontcolor="#5D1715"];
  node [shape=box, style="rounded,filled", fillcolor="#F9E9E8", color="#5D1715", fontcolor="#1A1A1A", fontname="DejaVu Sans", fontsize=12, penwidth=1.2, margin="0.14,0.07"];
  edge [color="#666666", arrowsize=0.7, penwidth=1.0];
  RN [label=<<B>RecoveryNode</B><BR/><I>retry up to 6×</I>>];
  PS [label=<<B>PipelineSequence</B><BR/><I>replan while driving</I>>];
  RC [label=<<B>RateController</B><BR/><I>1 Hz</I>>];
  CPP [label="ComputePathToPose", fillcolor="white"];
  RF1 [label=<<B>ReactiveFallback</B><BR/><I>yield checks ticked continuously</I>>];
  S1 [label=<<B>Sequence</B><BR/><I>yield to human</I>>];
  HC [label="IsHumanClose?", shape=oval, style=filled, fillcolor="#F5EFD9"];
  W1 [label="Wait (cap 4 s)", fillcolor="white"];
  RF2 [label=<<B>ReactiveFallback</B><BR/><I>robot-aware yield</I>>];
  S2 [label=<<B>Sequence</B><BR/><I>yield to robot</I>>];
  RC2 [label="IsRobotClose?", shape=oval, style=filled, fillcolor="#F5EFD9"];
  W2 [label="Wait (cap 10 s)", fillcolor="white"];
  RF3 [label=<<B>ReactiveFallback</B>>];
  S3 [label=<<B>Sequence</B><BR/><I>arc once after a yield</I>>];
  JY [label="just_yielded?", shape=oval, style=filled, fillcolor="#F5EFD9"];
  ARC [label="Arc", fillcolor="white"];
  FP [label="FollowPath", fillcolor="white"];
  REC [label=<<B>Recovery</B><BR/><I>round-robin</I><BR/><I>clear costmaps → wait 2 s → back up (rear-gated)</I>>, style="rounded,dashed,filled"];
  RN -> PS;
  RN -> REC [style=dashed, label="on failure"];
  PS -> RC;
  RC -> CPP;
  PS -> RF1;
  RF1 -> S1;
  S1 -> HC;
  S1 -> W1;
  RF1 -> RF2;
  RF2 -> S2;
  S2 -> RC2;
  S2 -> W2;
  RF2 -> RF3;
  RF3 -> S3;
  S3 -> JY;
  S3 -> ARC;
  RF3 -> FP;
}
